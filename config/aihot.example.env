# Copy to a path OUTSIDE git (e.g. ~/.config/aihot-daily/aihot.env) and fill in.
# Never commit real secrets.

# --- paths on parent persistent Linux host ---
AIHOT_HOME=/opt/aihot-daily
AIHOT_REPO_DIR=/opt/aihot-daily/repo
AIHOT_LOG_DIR=/opt/aihot-daily/logs
AIHOT_LOCK_DIR=/opt/aihot-daily/locks
AIHOT_KIMI_WORK_DIR=/opt/aihot-daily/secrets
# Optional explicit webhook config file (url+secret). Do not put secrets in git.
# AIHOT_FEISHU_CONFIG=/opt/aihot-daily/secrets/feishu-webhook.json

# --- safety gates (keep OFF until single-point cutover) ---
AIHOT_DRY_RUN=1
AIHOT_ENABLE_SCHEDULE=0
AIHOT_ALLOW_LIVE_FETCH=0
AIHOT_HTTP_FETCH=0
AIHOT_ALLOW_GIT_PUSH=0
AIHOT_ALLOW_PUSH_MAIN=0
AIHOT_FEISHU_ENABLED=0

# --- runtime ---
TZ=Asia/Shanghai
AIHOT_PUBLISH_BRANCH=main
# Public API host (preferred live ingest: GET /api/v1/dailies)
AIHOT_URL=https://aihot.news
# Set AIHOT_HTTP_FETCH=1 for read-only public API ingest (no browser/CDP).
# AIHOT_GROUPS_FILE=   # parent-captured groups JSON fallback (HP DOM shape)
# CDP browser adapter is NOT implemented — do not rely on Chrome/DISPLAY for ingest.
